            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "watches"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const watches=pm.response.json().data; pm.test(\"Ten seed watches and category name\",()=> {pm.expect(watches.length).to.be.at.least(10); pm.expect(watches[0]).to.have.property(\"categoryName\"); pm.expect(watches[0]).to.have.property(\"waterResistance\");});"
