# Copy into your shell environment. Replace every placeholder before launching.
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=replace-with-your-sql-server-password
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
INTERNAL_API_KEY=replace-with-a-separate-random-internal-key
ACCOUNT_SERVICE_URL=http://localhost:8081
BRAND_SERVICE_URL=http://localhost:8082
WATCH_SERVICE_URL=http://localhost:8083
# Enable only while running the fault-injection Postman scenarios.
SAGA_FAULT_INJECTION=false
SQL_HOST_PORT=1433
GATEWAY_HOST_PORT=8080
